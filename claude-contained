#!/usr/bin/env bash
set -euo pipefail
CC_ORIGINAL_ARGS=("$@")

show_help() {
  cat <<'EOF'
Usage:
  claude-contained [options] [main_dir] [extra_dir ...] [-- <tool args...>]

Description:
  Runs AI coding assistants inside an Apple Containers sandbox.

Options:
  -t, --tool TOOL    AI tool to run: claude (default), codex, copilot, gemini, vibe
  -R, --rebuild[=MODE]  Rebuild image and exit: tools (default) or full
  -H PORT[:HOSTPORT] Forward host port to container localhost (can be repeated)
  -p HOST:CONTAINER  Publish container port to host (can be repeated)
  -s, --shell        Start a bash shell instead of the AI tool (for debugging)
  -S, --ssh          Enable SSH agent forwarding (for git push)
  -w, --worktree     Auto-include git worktree's main repository (skip prompt)
  -W, --lock-worktrees  Auto-lock hidden linked worktrees (skip prompt)
  -y, --yolo         Skip all permission prompts (tool-specific flag)
  -N, --contained-node-modules  Use container-specific node_modules (skip prompt)
  --share-skills=DIR  Share skill folders from DIR (repeatable; accepts ~/)
  --readonly-extras  Mount all extra dirs read-only (suffix overrides per-path)
  -a, --attach [NAME]  Attach to running container (runs tool, or bash with -s)
  -h, --help         Show this help message

Behavior:
  - If no directories are provided, defaults to the current directory.
  - Directories are mounted at their original host paths for full path parity.
  - Additional directories are automatically added via --add-dir (claude, codex only).
  - Append :ro to an extra dir to mount it read-only (or :rw to force read-write).
    The working directory cannot be read-only.
  - Tool configs (~/.claude, ~/.copilot, ~/.gemini, ~/.vibe), Maven cache (~/.m2), and Vaadin state (~/.vaadin) are bind-mounted.
  - Codex uses persistent per-folder state, separate from native CLI/Desktop history.
  - Existing same-folder containers require confirmation before reuse.
  - Apple allows concurrent Codex sessions in the owning container.
  - Rust state (~/.cargo, ~/.rustup) is bind-mounted from container-specific dirs under ~/.claude-contained (Linux binaries differ from the host's).
  - --share-skills=DIR mounts DIR as each tool's skills directory.
    Repeat to combine top-level skill directories; duplicate names are errors.
    Edits write to the source; new skills go to the first shared directory.
    Codex built-in skills remain available through ~/.codex/skills/.system.
  - SSH agent forwarding is disabled by default; use --ssh to enable (for git push).
  - Git worktrees are detected; main repository's .git directory is mounted for full git access.
  - Linked worktrees hidden from the container can be auto-locked while the container runs.

Examples:
  claude-contained                     # Run claude in current directory
  claude-contained -t codex .          # Run codex instead
  claude-contained -t copilot .        # Run copilot instead
  claude-contained -t gemini .         # Run gemini instead
  claude-contained -t vibe .           # Run vibe instead
  claude-contained . ../other/project  # Mount extra directories
  claude-contained . ../lib:ro         # Mount ../lib read-only
  claude-contained --readonly-extras . ../a ../b  # All extras read-only
  claude-contained . -- --model sonnet # Pass args to tool
  claude-contained -y -t codex .       # Codex with --yolo
  claude-contained -S .                # Enable SSH agent (for git push)
  claude-contained -s                  # Debug shell in current directory
  claude-contained --rebuild           # Refresh AI tools, then exit
  claude-contained --rebuild=full      # Full fresh rebuild, then exit
  claude-contained -p 8080:8080 .      # Expose port 8080
  claude-contained -H 3845 .           # Forward host:3845 to container localhost:3845
  claude-contained --share-skills=~/Projects/skills --share-skills=~/Projects/skills-public .
  claude-contained -a                  # List and attach to running container
  claude-contained -a myproject        # Attach or create named container
EOF
}

# Sanitize folder name for container naming
# - Extract basename
# - Lowercase
# - Replace non-alphanumeric with dash
# - Collapse multiple dashes
# - Truncate to max 20 chars
# - Handle empty result
sanitize_foldername() {
  local name
  name="$(basename "$1" | tr '[:upper:]' '[:lower:]')"  # lowercase (portable)
  name="$(echo "$name" | sed 's/[^a-z0-9]/-/g')"        # non-alphanumeric → dash
  name="$(echo "$name" | sed 's/-\{1,\}/-/g')"          # collapse dashes
  name="${name#-}"                                       # trim leading dash
  name="${name%-}"                                       # trim trailing dash
  name="$(echo "$name" | cut -c1-20)"                   # truncate (portable)
  [[ -z "$name" ]] && name="root"                       # fallback
  echo "$name"
}

resolve_path() {
  if command -v python3 &>/dev/null; then
    python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "$1"
  elif command -v realpath &>/dev/null; then
    realpath "$1"
  elif command -v readlink &>/dev/null && readlink -f / &>/dev/null; then
    readlink -f "$1"
  else
    # Fallback: works for directories
    (cd "$1" 2>/dev/null && pwd) || echo "$1"
  fi
}

container_arch() {
  local arch
  arch="$(uname -m)"
  # Normalize macOS arm64 to Linux aarch64
  [[ "$arch" == "arm64" ]] && arch="aarch64"
  echo "$arch"
}

dir_is_empty() {
  local entry
  for entry in "$1"/* "$1"/.[!.]* "$1"/..?*; do
    [[ -e "$entry" || -L "$entry" ]] && return 1
  done
  return 0
}

# Detect host's IANA timezone (e.g. "Europe/Helsinki") so the container clock
# matches the host. Works on macOS (/var/db/timezone/zoneinfo/...) and Linux
# (/usr/share/zoneinfo/...). Falls back to $TZ if set, then empty.
host_timezone() {
  if [[ -n "${TZ:-}" ]]; then
    echo "$TZ"
    return
  fi
  local link
  link="$(readlink /etc/localtime 2>/dev/null)" || return 0
  [[ "$link" == */zoneinfo/* ]] && echo "${link#*/zoneinfo/}"
}

find_build_context() {
  local script_path script_dir repo_root
  script_path="$(resolve_path "$0")"
  script_dir="$(dirname "$script_path")"
  if [[ -f "${script_dir}/Dockerfile" ]]; then
    echo "$script_dir"
    return 0
  fi
  repo_root="$(git -C "$script_dir" rev-parse --show-toplevel 2>/dev/null)" || true
  if [[ -n "$repo_root" && -f "${repo_root}/Dockerfile" ]]; then
    echo "$repo_root"
    return 0
  fi
  return 1
}

run_rebuild() (
  local mode="$1"
  local build_context refresh_token build_file source_bytes build_bytes

  build_context="$(find_build_context)" || {
    echo "Rebuild requires a repo-adjacent install with Dockerfile access." >&2
    echo "Place claude-contained in this repo checkout (or symlink to it) and retry." >&2
    exit 1
  }

  # Keep the build request below Apple Container's transport limit (#735).
  # Preserve parser directives and shebangs. Once a heredoc starts, retain
  # everything: comment-looking lines may be literal file contents.
  build_file="$(mktemp "${TMPDIR:-/tmp}/claude-contained-Dockerfile.XXXXXX")"
  trap 'rm -f "$build_file"' EXIT
  awk '
    /<</ { literal = 1 }
    !literal && /^#[[:space:]]/ && !/^#[[:space:]]*(syntax|escape|check)[[:space:]]*=/ { next }
    { print }
  ' "$build_context/Dockerfile" > "$build_file"
  source_bytes="$(wc -c < "$build_context/Dockerfile" | tr -d '[:space:]')"
  build_bytes="$(wc -c < "$build_file" | tr -d '[:space:]')"
  echo "Apple Container Dockerfile: ${source_bytes} -> ${build_bytes} bytes after comment trimming." >&2
  # Advisory headroom, not an exact protocol limit: request overhead varies.
  if (( build_bytes >= 14 * 1024 )); then
    echo "Warning: trimmed Dockerfile is still near Apple Container's reported ~16 KiB build-request limit." >&2
    echo "If you see 'Stream unexpectedly closed' or 'Transport became inactive', move inline scripts into COPYed files or shorten the Dockerfile. See https://github.com/apple/container/issues/735" >&2
  fi

  case "$mode" in
    tools)
      refresh_token="$(date -u +%Y%m%d%H%M%S)"
      echo "Rebuilding claude-contained image (AI tools refresh)..." >&2
      if container build --file "$build_file" --build-arg "AI_TOOLS_CACHE_BUST=${refresh_token}" -t claude-contained:latest "$build_context"; then
        return 0
      fi
      echo "AI tools refresh failed. Retrying with full rebuild..." >&2
      run_rebuild full
      return
      ;;
    full)
      echo "Rebuilding claude-contained image (full fresh rebuild)..." >&2
      container build --file "$build_file" --pull --no-cache -t claude-contained:latest "$build_context"
      ;;
    *)
      echo "Unknown rebuild mode: $mode" >&2
      echo "Supported rebuild modes: tools, full" >&2
      exit 1
      ;;
  esac
)

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  show_help
  exit 0
fi

# Parse flags (can appear in any order)
shell_mode=0
ssh_mode=0
worktree_mode=0
lock_worktrees=0
yolo_mode=0
contained_node_modules=0
attach_mode=0
attach_name=""
rebuild_mode="none"
tool="claude"
ro_default=0
share_skills_dir=""
share_skills_dirs=()
port_maps=()
host_forwards=()
while [[ "${1:-}" == -* ]]; do
  case "${1:-}" in
    -h|--help)
      show_help
      exit 0
      ;;
    --readonly-extras)
      ro_default=1
      shift
      ;;
    --share-skills)
      echo "error: --share-skills requires --share-skills=DIR" >&2
      exit 2
      ;;
    --share-skills=*)
      share_skills_dir="${1#*=}"
      if [[ -z "$share_skills_dir" ]]; then
        echo "error: --share-skills requires a non-empty directory" >&2
        exit 2
      fi
      share_skills_dirs+=("$share_skills_dir")
      shift
      ;;
    --rebuild)
      rebuild_mode="tools"
      shift
      ;;
    --rebuild=*)
      rebuild_mode="${1#*=}"
      shift
      ;;
    -R)
      if [[ "${2:-}" == "tools" || "${2:-}" == "full" ]]; then
        rebuild_mode="$2"
        shift 2
      else
        rebuild_mode="tools"
        shift
      fi
      ;;
    -s|--shell)
      shell_mode=1
      shift
      ;;
    -S|--ssh)
      ssh_mode=1
      shift
      ;;
    -w|--worktree)
      worktree_mode=1
      shift
      ;;
    -W|--lock-worktrees)
      lock_worktrees=1
      shift
      ;;
    -y|--yolo)
      yolo_mode=1
      shift
      ;;
    -N|--contained-node-modules)
      contained_node_modules=1
      shift
      ;;
    -t|--tool)
      shift
      tool="$1"
      shift
      ;;
    -p)
      shift
      port_maps+=("$1")
      shift
      ;;
    -H)
      shift
      host_forwards+=("$1")
      shift
      ;;
    -a|--attach)
      attach_mode=1
      shift
      # If next arg exists and doesn't start with - and isn't a path, treat as container name
      if [[ -n "${1:-}" && "${1:-}" != -* && "${1:-}" != */* && "${1:-}" != "." ]]; then
        attach_name="$1"
        shift
      fi
      ;;
    *)
      break
      ;;
  esac
done

for i in "${!share_skills_dirs[@]}"; do
  share_skills_dir="${share_skills_dirs[$i]}"
  case "$share_skills_dir" in
    '~') share_skills_dir="$HOME" ;;
    '~/'*) share_skills_dir="$HOME/${share_skills_dir:2}" ;;
  esac
  if [[ ! -d "$share_skills_dir" ]]; then
    echo "error: --share-skills directory does not exist: $share_skills_dir" >&2
    exit 2
  fi
  share_skills_dirs[$i]="$(resolve_path "$share_skills_dir")"
done

# Ensure container system is running (skipped when sourced for tests)
if [[ -z "${CLAUDE_CONTAINED_LIB_ONLY:-}" ]] && ! container system status &>/dev/null; then
  read -p "Container system is not running. Start it? [Y/n] " answer
  case "${answer:-Y}" in
    [Yy]* ) container system start ;;
    * ) echo "Aborted."; exit 1 ;;
  esac
fi

# Handle rebuild mode (rebuild and exit)
if [[ "$rebuild_mode" != "none" ]]; then
  run_rebuild "$rebuild_mode"
  exit 0
fi

# Split directories (before --) vs tool args (after --)
paths=()
tool_args=()
seen_sep=0
for a in "$@"; do
  if [[ "$a" == "--" ]]; then
    seen_sep=1
    continue
  fi
  if [[ $seen_sep -eq 0 ]]; then
    paths+=("$a")
  else
    tool_args+=("$a")
  fi
done

explicit_paths=0
[[ ${#paths[@]} -gt 0 ]] && explicit_paths=1

# If user did: claude-contained -- <claude args...>
if [[ ${#paths[@]} -eq 0 ]]; then
  paths+=(".")
fi

# Strip :ro / :rw suffixes; build parallel path_modes[] (rw|ro per index).
# Working dir (index 0) cannot be ro. --readonly-extras sets the default for
# unsuffixed extras; an explicit suffix always wins.
path_modes=()
for i in "${!paths[@]}"; do
  p="${paths[$i]}"
  mode=""
  if   [[ "$p" == *:ro ]]; then p="${p%:ro}"; mode="ro"
  elif [[ "$p" == *:rw ]]; then p="${p%:rw}"; mode="rw"
  fi
  if [[ $i -eq 0 ]]; then
    if [[ "$mode" == "ro" ]]; then
      echo "error: working directory cannot be read-only" >&2
      exit 2
    fi
    mode="rw"
  elif [[ -z "$mode" ]]; then
    [[ $ro_default -eq 1 ]] && mode="ro" || mode="rw"
  fi
  paths[$i]="$p"
  path_modes+=("$mode")
done

# Detect if directory is a git worktree and return main repo path
# Returns empty string if not a worktree
get_worktree_main_repo() {
  local dir="$1"
  local git_file="${dir}/.git"

  # Check if .git is a file (worktree) not a directory (regular repo)
  if [[ -f "$git_file" ]]; then
    # Use git to find the main repository's .git directory
    local common_dir
    common_dir="$(cd "$dir" && git rev-parse --git-common-dir 2>/dev/null)" || return

    # Get the main repo root (parent of .git)
    if [[ -n "$common_dir" && "$common_dir" != ".git" ]]; then
      dirname "$(resolve_path "$common_dir")"
    fi
  fi
}

get_main_worktree_repo_root() {
  local dir="$1"
  local repo_root common_dir common_abs main_git_abs

  repo_root="$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null)" || return
  [[ -d "${repo_root}/.git" ]] || return

  common_dir="$(git -C "$repo_root" rev-parse --git-common-dir 2>/dev/null)" || return
  common_abs="$(cd "$repo_root" && resolve_path "$common_dir")"
  main_git_abs="$(resolve_path "${repo_root}/.git")"

  [[ "$common_abs" == "$main_git_abs" ]] && echo "$repo_root"
}

path_is_at_or_under() {
  local path="${1%/}"
  local parent="${2%/}"

  [[ "$path" == "$parent" || "$path" == "$parent"/* ]]
}

path_visible_in_container() {
  local path="$1"
  local mounted

  for mounted in "${mounted_roots[@]+"${mounted_roots[@]}"}"; do
    if path_is_at_or_under "$path" "$mounted"; then
      return 0
    fi
  done
  return 1
}

AUTO_LOCK_PREFIX="cc-autolocked-by:"
# A held mutex lives only a fraction of a second; anything older than this was
# left by a launcher that died without releasing it and may be reclaimed.
WORKTREE_LOCK_MUTEX_STALE_SECS=30
WORKTREE_CLEANUP_DONE=0
auto_worktree_lock_repo=""
auto_locked_worktrees=()

get_worktree_lock_file() {
  local wt_path="$1"
  local git_dir

  git_dir="$(git -C "$wt_path" rev-parse --git-dir 2>/dev/null)" || return 1
  git_dir="$(cd "$wt_path" && resolve_path "$git_dir")"
  echo "${git_dir}/locked"
}

# Decide whether a mutex directory we failed to create was abandoned by a dead
# launcher. Without this, a single crash/kill while the mutex was briefly held
# would block every future run on the repo, silently disabling auto-locking.
mutex_holder_is_stale() {
  local lock_dir="$1"
  local owner_file="${lock_dir}/owner"
  local holder_pid="" holder_ts="" now age

  # A live holder writes its owner file within microseconds of creating the
  # directory; a persistently missing one means the holder died mid-acquire.
  [[ -f "$owner_file" ]] || return 0

  read -r holder_pid holder_ts < "$owner_file" 2>/dev/null || true

  # Holder process is gone -> stale.
  if [[ -n "$holder_pid" ]] && ! kill -0 "$holder_pid" 2>/dev/null; then
    return 0
  fi

  # Age fallback guards against PID reuse and platforms with unreliable kill -0.
  now="$(date +%s 2>/dev/null || echo 0)"
  if [[ -n "$holder_ts" && "$holder_ts" -gt 0 && "$now" -gt "$holder_ts" ]]; then
    age=$((now - holder_ts))
    [[ $age -ge $WORKTREE_LOCK_MUTEX_STALE_SECS ]] && return 0
  fi

  return 1
}

with_worktree_lock_mutex() {
  local repo_root="$1"
  local lock_dir="${repo_root}/.git/claude-contained-worktree-locks.lock"
  local waited=0

  while ! mkdir "$lock_dir" 2>/dev/null; do
    # After a short grace period, reclaim the lock if its holder is gone.
    if [[ $waited -ge 5 ]] && mutex_holder_is_stale "$lock_dir"; then
      echo "Note: reclaiming stale worktree auto-lock mutex from a defunct launcher" >&2
      rm -f "${lock_dir}/owner" 2>/dev/null || true
      rmdir "$lock_dir" 2>/dev/null || true
      waited=0
      continue
    fi
    if [[ $waited -ge 50 ]]; then
      echo "Warning: timed out waiting for worktree auto-lock mutex" >&2
      return 1
    fi
    sleep 0.1
    waited=$((waited + 1))
  done

  # Record holder identity + time so a later run can detect a stale hold.
  printf '%s %s\n' "$$" "$(date +%s 2>/dev/null || echo 0)" > "${lock_dir}/owner" 2>/dev/null || true
  WORKTREE_LOCK_MUTEX_DIR="$lock_dir"
}

release_worktree_lock_mutex() {
  if [[ -n "${WORKTREE_LOCK_MUTEX_DIR:-}" ]]; then
    rm -f "${WORKTREE_LOCK_MUTEX_DIR}/owner" 2>/dev/null || true
    rmdir "$WORKTREE_LOCK_MUTEX_DIR" 2>/dev/null || true
    WORKTREE_LOCK_MUTEX_DIR=""
  fi
}

reason_has_auto_owner() {
  local reason="$1"
  local owner="$2"
  local owner_part existing

  [[ "$reason" == "$AUTO_LOCK_PREFIX"* ]] || return 1
  owner_part="${reason#${AUTO_LOCK_PREFIX}}"
  for existing in $owner_part; do
    [[ "$existing" == "$owner" ]] && return 0
  done
  return 1
}

write_auto_lock_reason() {
  local lock_file="$1"
  shift
  local reason="$AUTO_LOCK_PREFIX"
  local owner

  for owner in "$@"; do
    reason="${reason} ${owner}"
  done
  printf '%s\n' "$reason" > "$lock_file"
}

append_auto_lock_owner() {
  local lock_file="$1"
  local owner="$2"
  local reason owner_part existing
  local owners=()

  reason="$(cat "$lock_file" 2>/dev/null || true)"
  [[ "$reason" == "$AUTO_LOCK_PREFIX"* ]] || return 1
  reason_has_auto_owner "$reason" "$owner" && return 0

  owner_part="${reason#${AUTO_LOCK_PREFIX}}"
  for existing in $owner_part; do
    owners+=("$existing")
  done
  owners+=("$owner")
  write_auto_lock_reason "$lock_file" "${owners[@]}"
}

record_auto_locked_worktree() {
  local wt_path="$1"
  local existing

  for existing in "${auto_locked_worktrees[@]+"${auto_locked_worktrees[@]}"}"; do
    [[ "$existing" == "$wt_path" ]] && return 0
  done
  auto_locked_worktrees+=("$wt_path")
}

add_auto_worktree_lock_owner() {
  local repo_root="$1"
  local wt_path="$2"
  local owner="$3"
  local lock_file reason

  lock_file="$(get_worktree_lock_file "$wt_path")" || return 1
  if [[ -f "$lock_file" ]]; then
    append_auto_lock_owner "$lock_file" "$owner" || return 1
  else
    if ! git -C "$repo_root" worktree lock --reason "${AUTO_LOCK_PREFIX} ${owner}" "$wt_path" 2>/dev/null; then
      reason="$(cat "$lock_file" 2>/dev/null || true)"
      [[ "$reason" == "$AUTO_LOCK_PREFIX"* ]] || return 1
      append_auto_lock_owner "$lock_file" "$owner" || return 1
    fi
  fi

  record_auto_locked_worktree "$wt_path"
}

remove_auto_worktree_lock_owner() {
  local repo_root="$1"
  local wt_path="$2"
  local owner="$3"
  local lock_file reason owner_part existing
  local owners=()
  local found=0

  [[ -d "$wt_path" ]] || return 0
  lock_file="$(get_worktree_lock_file "$wt_path")" || return 0
  [[ -f "$lock_file" ]] || return 0

  reason="$(cat "$lock_file" 2>/dev/null || true)"
  [[ "$reason" == "$AUTO_LOCK_PREFIX"* ]] || return 0

  owner_part="${reason#${AUTO_LOCK_PREFIX}}"
  for existing in $owner_part; do
    if [[ "$existing" == "$owner" ]]; then
      found=1
    else
      owners+=("$existing")
    fi
  done
  [[ $found -eq 1 ]] || return 0

  if [[ ${#owners[@]} -eq 0 ]]; then
    git -C "$repo_root" worktree unlock "$wt_path" 2>/dev/null || rm -f "$lock_file"
  else
    write_auto_lock_reason "$lock_file" "${owners[@]}"
  fi
}

cleanup_auto_worktree_locks() {
  local wt_path
  local mutex_held=0

  [[ ${WORKTREE_CLEANUP_DONE:-0} -eq 1 ]] && return 0
  WORKTREE_CLEANUP_DONE=1

  [[ -n "$auto_worktree_lock_repo" && ${#auto_locked_worktrees[@]} -gt 0 ]] || return 0

  if [[ -n "${WORKTREE_LOCK_MUTEX_DIR:-}" ]]; then
    mutex_held=1
  elif with_worktree_lock_mutex "$auto_worktree_lock_repo"; then
    mutex_held=1
  fi

  # Only edit the owner list while holding the mutex: a racing cleanup could
  # otherwise drop a still-live owner and unlock a worktree another container is
  # using. If the mutex is unavailable, leave the locks in place (release with
  # `git worktree unlock`); erring toward over-locking never destroys data.
  if [[ $mutex_held -eq 1 ]]; then
    for wt_path in "${auto_locked_worktrees[@]}"; do
      remove_auto_worktree_lock_owner "$auto_worktree_lock_repo" "$wt_path" "$container_name"
    done
    release_worktree_lock_mutex
  else
    echo "Warning: could not acquire worktree auto-lock mutex during cleanup;" >&2
    echo "         leaving auto-locks in place (release with 'git -C \"${auto_worktree_lock_repo}\" worktree unlock <path>')." >&2
  fi
  return 0
}

maybe_offer_worktree_locks() {
  local repo_root="$1"
  local container_name="$2"
  local line wt_path locked locked_reason prunable
  local hidden_worktrees=()

  [[ -n "$repo_root" ]] || return 0
  path_visible_in_container "${repo_root}/.git" || return 0

  wt_path=""
  locked=0
  locked_reason=""
  prunable=0
  while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ -z "$line" ]]; then
      if [[ -n "$wt_path" && "$wt_path" != "$repo_root" && $prunable -eq 0 && -d "$wt_path" ]]; then
        if ! path_visible_in_container "$wt_path"; then
          if [[ $locked -eq 0 || "$locked_reason" == "$AUTO_LOCK_PREFIX"* ]]; then
            hidden_worktrees+=("$wt_path")
          fi
        fi
      fi
      wt_path=""
      locked=0
      locked_reason=""
      prunable=0
      continue
    fi

    case "$line" in
      worktree\ *) wt_path="${line#worktree }" ;;
      locked*) locked=1; locked_reason="${line#locked}"; locked_reason="${locked_reason# }" ;;
      prunable*) prunable=1 ;;
    esac
  done < <(git -C "$repo_root" worktree list --porcelain 2>/dev/null || true)

  if [[ -n "$wt_path" && "$wt_path" != "$repo_root" && $prunable -eq 0 && -d "$wt_path" ]]; then
    if ! path_visible_in_container "$wt_path"; then
      if [[ $locked -eq 0 || "$locked_reason" == "$AUTO_LOCK_PREFIX"* ]]; then
        hidden_worktrees+=("$wt_path")
      fi
    fi
  fi

  [[ ${#hidden_worktrees[@]} -gt 0 ]] || return 0

  echo "${#hidden_worktrees[@]} linked worktree(s) under ${repo_root} hidden from container (prune risk)."
  if [[ ${lock_worktrees:-0} -eq 1 ]]; then
    answer="Y"
  else
    read -p "Auto-lock them while this container runs? [Y/n] " answer
  fi
  case "${answer:-Y}" in
    [Yy]* )
      auto_worktree_lock_repo="$repo_root"
      # Fail safe: if the mutex is unavailable, still apply the locks rather
      # than launch the container with the worktrees unprotected. The mutex only
      # serializes the owner-list bookkeeping; a lone racing append at worst
      # leaks a lock (over-protection), never a removal.
      if ! with_worktree_lock_mutex "$repo_root"; then
        echo "Warning: proceeding to auto-lock without the serialization mutex;" >&2
        echo "         a concurrent launcher on this repo could race on lock bookkeeping." >&2
      fi
      for wt_path in "${hidden_worktrees[@]}"; do
        if ! add_auto_worktree_lock_owner "$repo_root" "$wt_path" "$container_name"; then
          echo "Warning: could not auto-lock ${wt_path}; leaving it unchanged" >&2
        fi
      done
      release_worktree_lock_mutex
      echo "Auto-locked ${#auto_locked_worktrees[@]} worktree(s)."
      ;;
  esac
}

check_for_updates() {
  (
    local script_path script_dir repo_root local_rev upstream_rev
    script_path="$(resolve_path "$0")"
    script_dir="$(dirname "$script_path")"
    repo_root="$(git -C "$script_dir" rev-parse --show-toplevel 2>/dev/null)" || return 0
    git -C "$repo_root" fetch --quiet 2>/dev/null || return 0
    local_rev="$(git -C "$repo_root" rev-parse HEAD 2>/dev/null)" || return 0
    upstream_rev="$(git -C "$repo_root" rev-parse '@{u}' 2>/dev/null)" || return 0
    if [[ "$local_rev" != "$upstream_rev" ]]; then
      echo ""
      echo "Update available for claude-contained! Run 'git -C ${repo_root} pull' to update."
    fi
  ) 2>/dev/null || true
}

# Use the first source as the writable root, then mount additional skills below
# it. Empty directories in the first source are safe mountpoints (including
# those created by previous launches); never hide files, links, or nonempty dirs.
prepare_shared_skills() {
  share_skills_dir=""
  shared_skill_names=()
  shared_skill_paths=()
  shared_skills_targets=()
  [[ ${#share_skills_dirs[@]} -gt 0 ]] || return 0
  share_skills_dir="${share_skills_dirs[0]}"

  local src entry name previous dst
  for src in "${share_skills_dirs[@]:1}"; do
    for entry in "$src"/*; do
      [[ -d "$entry" ]] || continue
      # Ignore empty mountpoints left when this source was previously first.
      dir_is_empty "$entry" && continue
      name="${entry##*/}"
      dst="$share_skills_dir/$name"
      if [[ -L "$dst" ]] || { [[ -e "$dst" ]] && { [[ ! -d "$dst" ]] || ! dir_is_empty "$dst"; }; }; then
        echo "error: duplicate shared skill '$name': $dst and $entry" >&2
        return 2
      fi
      for previous in "${shared_skill_names[@]+"${shared_skill_names[@]}"}"; do
        if [[ "$name" == "$previous" ]]; then
          echo "error: duplicate shared skill directory '$name' in --share-skills sources" >&2
          return 2
        fi
      done
      shared_skill_names+=("$name")
      shared_skill_paths+=("$(resolve_path "$entry")")
    done
  done
}

add_shared_skills_mount() {
  local dst="$1"
  local dst_parent="$2"
  local index name

  [[ -n "$dst_parent" ]] && mkdir -p "$dst_parent"
  container_argv+=( --mount "type=bind,src=${share_skills_dir},dst=${dst}" )
  for index in "${!shared_skill_names[@]}"; do
    name="${shared_skill_names[$index]}"
    # Bind mounts need an empty destination; these contain no copied skill data
    # and Git does not track them. New top-level skills write to the root mount.
    mkdir -p "$share_skills_dir/$name"
    container_argv+=( --mount "type=bind,src=${shared_skill_paths[$index]},dst=${dst}/${name}" )
  done
  shared_skills_targets+=("$dst")
}

shared_skills_display_path() {
  case "$1" in
    "$HOME") printf '~' ;;
    "$HOME/"*) printf '~/%s' "${1#"$HOME/"}" ;;
    *) printf '%s' "$1" ;;
  esac
}

show_shared_skills_summary() {
  local path separator=""
  {
    printf 'Skills: ['
    for path in "${share_skills_dirs[@]}"; do
      printf '%s' "$separator"
      shared_skills_display_path "$path"
      [[ -n "$separator" ]] || printf ' (new skills here)'
      separator=", "
    done
    printf '] -> ['
    separator=""
    for path in "${shared_skills_targets[@]}"; do
      printf '%s' "$separator"
      shared_skills_display_path "$path"
      separator=", "
    done
    printf ']\n'
  } >&2
}

# Native host supervisor is embedded to preserve single-file launcher installs.
managed_launch() {
  python3 -c "$(cat <<'CC_MANAGED_PY'
# BEGIN EMBEDDED MANAGED LAUNCH
#!/usr/bin/env python3
"""Host-only lifecycle supervisor, embedded in both standalone launchers.
Regenerate embedded copies with: python3 tests/embed-managed-launch.py
Never mount this supervisor's lock directory into a container.
"""
import fcntl
import hashlib
import json
import os
from pathlib import Path
import re
import shutil
import signal
import subprocess
import sys
import uuid

LABEL = 'io.claude-contained.owner'


def fail(message):
    raise RuntimeError(message)


def canonical(path):
    path = Path(path).resolve(strict=True)
    if not path.is_dir():
        fail(f'Not a directory: {path}')
    # realpath alone preserves case aliases on case-insensitive macOS volumes.
    parts = []
    while path != path.parent:
        matches = [n for n in os.listdir(path.parent)
                   if n.casefold() == path.name.casefold() and os.path.samefile(path.parent / n, path)]
        parts.append(path.name if path.name in matches else matches[0])
        path = path.parent
    value = str(path.joinpath(*reversed(parts)))
    if any(c in value for c in '\n\r,:'):
        fail('Mount paths cannot contain commas, colons, or newlines.')
    return value


def key_for(folder):
    name = re.sub('[^a-z0-9]+', '-', Path(folder).name.lower()).strip('-')[:20] or 'root'
    return name + '-' + hashlib.sha256(folder.encode()).hexdigest()[:24]


def atomic_json(path, value):
    temp = path.with_name(path.name + '.' + uuid.uuid4().hex)
    try:
        with temp.open('x') as f:
            json.dump(value, f)
            f.flush()
            os.fsync(f.fileno())
        os.replace(temp, path)
    finally:
        temp.unlink(missing_ok=True)


def read_json(path):
    try:
        return json.loads(path.read_text())
    except FileNotFoundError:
        return None


def run(args):
    p = subprocess.run(args, capture_output=True, text=True, timeout=20)
    if p.returncode:
        fail(f'Cannot verify {args[0]} container state; ownership retained. {p.stderr.strip()}')
    return p.stdout


def containers(runtime):
    if runtime == 'container':
        rows = json.loads(run(['container', 'list', '--all', '--format', 'json']))
        return [{'name': r['configuration']['id'], 'state': r['status']['state'],
                 'token': r['configuration'].get('labels', {}).get(LABEL)} for r in rows]
    rows = run(['docker', 'ps', '--all', '--format', '{{json .}}']).splitlines()
    return [{'name': r['Names'], 'state': r['State'],
             'token': dict(s.split('=', 1) for s in r.get('Labels', '').split(',') if '=' in s).get(LABEL)}
            for r in map(json.loads, rows)]


def live_owner(record):
    rows = containers(record['runtime'])
    matches = [r for r in rows if r['name'] == record['name']]
    if not matches:
        return None
    row = matches[0]
    if row['token'] != record['token']:
        fail('Container name now belongs to a different owner; refusing reuse or automatic recovery.')
    # An existing stopped container can still be restarted manually. Retain its
    # reservation until it is removed, rather than authorize a second mount.
    return row


def validate_mount_sources(home, paths, skills):
    protected = [Path(home) / '.codex', Path(home) / '.claude-contained']
    for source in paths + skills:
        p = Path(source)
        for q in protected:
            if p == q or p in q.parents or q in p.parents:
                fail(f'Mount {p} would expose native Codex state or contained stores. Select a project/skills subdirectory outside {q}.')


def validate_tool_args(tool, args):
    if tool != 'codex':
        return
    for arg in args:
        if arg in ('-C', '--cd') or arg.startswith(('--cd=', '-C')):
            fail('Pass the working folder to the launcher, not Codex --cd/-C, so history ownership matches it.')
        if 'sqlite_home' in arg or 'CODEX_HOME' in arg or 'CODEX_SQLITE_HOME' in arg:
            fail('Contained Codex database/home overrides are not supported.')


def prepare_store(base, folder):
    project = base / 'projects' / key_for(folder)
    identity = {'format': 1, 'canonical_path': folder}
    project.mkdir(parents=True, exist_ok=True)
    if project.is_symlink() or project.resolve() != project:
        fail('Contained state must not be redirected by symlinks.')
    existing = read_json(project / 'identity.json')
    if existing is not None and existing != identity:
        fail('Stored folder identity does not match this folder.')
    store = project / 'home'
    if existing is None:
        if store.exists():
            fail(f'Incomplete initialization at {project}; inspect it before retrying.')
        temporary = project / ('seed-' + uuid.uuid4().hex)
        temporary.mkdir(mode=0o700)
        native = Path(os.environ['HOME']) / '.codex'
        # Private copies only. Never copy databases, sidecars, transcripts,
        # caches, sockets, or the current native runtime directory wholesale.
        for name in ('auth.json', 'config.toml', 'AGENTS.md', 'skills', 'plugins'):
            source = native / name
            if source.is_dir():
                shutil.copytree(source, temporary / name, symlinks=False)
            elif source.is_file():
                shutil.copyfile(source, temporary / name)
        os.replace(temporary, store)
        atomic_json(project / 'identity.json', identity)
        print(f'Created private Codex home for {folder}. History starts fresh; setup is copied once.', file=sys.stderr)
    if not store.is_dir() or store.is_symlink():
        fail('Invalid contained Codex home.')
    # Do not follow state symlinks into some other store, even after a prior run.
    for parent, dirs, files in os.walk(store):
        for name in dirs + files:
            p = Path(parent) / name
            if p.is_symlink() and not p.resolve().is_relative_to(store):
                fail(f'Contained Codex home has an external symlink: {p}')
    return store


def prepare_shared(home):
    parent = Path(home) / '.claude-contained'
    with (parent / 'shared.lock').open('a') as mutex:
        fcntl.flock(mutex, fcntl.LOCK_EX)
        shared = parent / 'shared'
        shared.mkdir(exist_ok=True)
        old, new = parent / '.claude.json', shared / '.claude.json'
        if old.is_file() and not old.is_symlink():
            if new.exists():
                fail('Both old and new shared Claude configs exist; resolve them before launch.')
            old.rename(new)
        if not old.exists() and not old.is_symlink():
            old.symlink_to('shared/.claude.json')
        native = Path(home) / '.claude.json'
        if native.is_file() and not native.is_symlink():
            os.replace(native, new)
        if not native.exists() and not native.is_symlink() and new.exists():
            native.symlink_to(new)
        gitconfig = Path(home) / '.gitconfig'
        if gitconfig.is_file():
            temporary = shared / ('.gitconfig.' + uuid.uuid4().hex)
            shutil.copyfile(gitconfig, temporary)
            os.replace(temporary, shared / '.gitconfig')
        return shared


def ready(record):
    row = live_owner(record)
    if not row or row['state'] != 'running':
        fail('The owning container is starting, stopped, or exiting. No second container was started.')
    p = subprocess.run([record['runtime'], 'exec', record['name'], 'cat',
                        '/run/claude-contained/identity.json'], capture_output=True, text=True, timeout=20)
    if p.returncode:
        fail('Container is not ready or uses an old image. Wait for startup, or rebuild the image after stopping it.')
    info = json.loads(p.stdout)
    if info != {'token': record['token'], 'runtime': record['runtime'], 'home': record['home']}:
        fail('Container ownership/readiness identity mismatch.')


def attach(record, request):
    if request['runtime'] != record['runtime']:
        fail(f"Folder is owned by {record['runtime']} container {record['name']}; use that runtime to attach.")
    if request['setup'] != record['setup']:
        differences = [k for k in request['setup'] if request['setup'][k] != record['setup'].get(k)]
        fail('Existing container has incompatible launch options: ' + ', '.join(differences) + '. Repeat the original setup options or stop the owner first.')
    ready(record)
    if request['tool'] == 'codex' and not request['shell'] and record['runtime'] == 'docker':
        p = subprocess.run(['docker', 'exec', '-u', 'dev', record['name'], '/usr/local/bin/codex', '--cc-check-idle'],
                           capture_output=True, text=True, timeout=20)
        if p.returncode:
            fail(p.stderr.strip() or 'Docker permits only one Codex process per folder.')
    print(f"Folder {record['folder']} already uses {record['runtime']} container {record['name']}.\n"
          'Attachment starts another process sharing its filesystem and lifecycle.\n'
          'It can be terminated when the original container session exits.', file=sys.stderr)
    try:
        answer = input(f"Start {'bash' if request['shell'] else request['tool']} in this container? [y/N] ")
    except EOFError:
        answer = ''
    if answer.lower() not in ('y', 'yes'):
        fail('Attachment cancelled; no new container started.')
    ready(record)
    home = record['home']
    command = ['bash'] if request['shell'] else [('/opt/claude/claude' if request['tool'] == 'claude' else request['tool'])]
    if not request['shell']:
        if request['yolo'] and request['tool'] != 'vibe':
            command.append('--dangerously-skip-permissions' if request['tool'] == 'claude' else '--yolo')
        for path in request['setup']['paths'][1:]:
            if request['tool'] in ('claude', 'codex'):
                command.extend(['--add-dir', path])
        command.extend(request['args'])
    env = {'HOME': home, 'JAVA_HOME': '/opt/jbr', 'CARGO_HOME': home + '/.cargo',
           'RUSTUP_HOME': home + '/.rustup', 'DYLINT_DRIVER_PATH': home + '/.cargo/dylint-drivers',
           'PATH': home + '/.cargo/bin:' + home + '/.local/bin:/opt/claude:/opt/jbr/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'}
    argv = [record['runtime'], 'exec', '-it', '-u', 'dev', '-w', record['folder']]
    for k, v in env.items():
        argv.extend(['-e', k + '=' + v])
    return subprocess.call(argv + [record['name']] + command)


def supervise(request, launcher, original):
    home = canonical(os.environ['HOME'])
    base = Path(home) / '.claude-contained' / 'codex'
    base.mkdir(parents=True, exist_ok=True, mode=0o700)
    if base.resolve() != base:
        fail('The contained state root cannot be a symlink.')
    locks = base / 'locks'
    locks.mkdir(exist_ok=True)
    rows = containers(request['runtime'])
    # Legacy containers still expose the entire state parent through a broad
    # bind mount. Require their shutdown before creating private stores there.
    legacy = [r['name'] for r in rows if r['name'].startswith('aic-') and not r['token']]
    if legacy:
        fail('Remove legacy containers before using isolated state: ' + ', '.join(legacy))
    selected = None
    if request['attach']:
        records = [read_json(p) for p in locks.glob('*.json')]
        records = [r for r in records if r and r['runtime'] == request['runtime']]
        name = request['name']
        if not name:
            records = [r for r in records if any(c['token'] == r['token'] and c['state'] == 'running' for c in rows)]
            if not records:
                fail('No running managed containers to attach to.')
            for i, r in enumerate(records, 1):
                print(f"{i}) {r['name']} — {r['folder']}")
            try:
                choice = input('Select container number (empty cancels): ')
            except EOFError:
                choice = ''
            if not choice.isdigit() or not 1 <= int(choice) <= len(records):
                fail('Attachment cancelled.')
            selected = records[int(choice) - 1]
        else:
            name = 'aic-' + re.sub('[^a-z0-9-]', '-', name.removeprefix('aic-').lower())
            selected = next((r for r in records if r['name'] == name), None)
            if selected is None and any(r['name'] == name for r in rows):
                fail('Container has no matching ownership record; refusing unsafe attachment.')
        if selected and not request['explicit_paths']:
            request['setup']['paths'] = [selected['folder']]
            request['setup']['modes'] = ['rw']
    request['setup']['paths'] = [canonical(p) for p in request['setup']['paths']]
    request['setup']['skills'] = [canonical(p) for p in request['setup']['skills']]
    folder = request['setup']['paths'][0]
    if selected and folder != selected['folder']:
        fail('Requested working folder differs from the selected container.')
    validate_mount_sources(home, request['setup']['paths'], request['setup']['skills'])
    validate_tool_args(request['tool'], request['args'])
    key = key_for(folder)
    record_path = locks / (key + '.json')
    # Never unlink these lock files: deleting a locked inode would create two
    # independent locks. The native kernel releases flock after process death.
    with (locks / (key + '.lock')).open('a') as mutex:
        try:
            fcntl.flock(mutex, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            record = read_json(record_path)
            if not record:
                fail('Another launch is reserving this folder. Retry when it is ready.')
            return attach(record, request)
        record = read_json(record_path)
        if record and live_owner(record):
            return attach(record, request)
        if selected:
            fail('Selected container has exited. Retry as a normal launch.')
        token = uuid.uuid4().hex
        name = request['name']
        name = ('aic-' + re.sub('[^a-z0-9-]', '-', name.removeprefix('aic-').lower())) if name else 'aic-' + key[:20] + '-' + token[:8]
        if any(r['name'] == name for r in rows):
            fail('Requested container name is already in use.')
        store = prepare_store(base, folder)
        shared = prepare_shared(home)
        record = {'format': 1, 'folder': folder, 'home': home, 'runtime': request['runtime'],
                  'name': name, 'token': token, 'setup': request['setup']}
        atomic_json(record_path, record)
        env = dict(os.environ, HOME=home, CC_TOKEN=token, CC_CODEX_HOME=str(store), CC_CONTAINER_NAME=name,
                   CC_MAIN_FOLDER=folder, CC_RUNTIME=request['runtime'], CC_SHARED_DIR=str(shared),
                   CC_PATHS='\n'.join(request['setup']['paths']), CC_SKILLS='\n'.join(request['setup']['skills']))
        # The child bash retains the lock FD too, so killing this supervisor
        # cannot authorize a competing launcher while the first is starting.
        child = subprocess.Popen(['bash', launcher, *original], env=env, pass_fds=(mutex.fileno(),))
        def forward(sig, frame):
            if child.poll() is None:
                child.send_signal(sig)
        for sig in (signal.SIGTERM, signal.SIGHUP, signal.SIGINT):
            signal.signal(sig, forward)
        status = child.wait()
        try:
            if not live_owner(record) and read_json(record_path) == record:
                record_path.unlink()
        except (RuntimeError, subprocess.TimeoutExpired):
            print('Runtime state unavailable; retaining folder ownership for the next launch to verify.', file=sys.stderr)
        return status


def main(argv):
    if sys.version_info < (3, 9):
        fail('Managed launchers require host Python 3.9 or newer.')
    runtime, launcher, tool, shell, yolo, attach_mode, name, ssh, worktree, locks, node, memory, explicit = argv[:13]
    rest = iter(argv[13:])
    def array():
        return [next(rest) for _ in range(int(next(rest)))]
    paths, modes, skills, ports, forwards, args, original = [array() for _ in range(7)]
    request = {'runtime': runtime, 'tool': tool, 'shell': shell == '1', 'yolo': yolo == '1',
               'attach': attach_mode == '1', 'name': name, 'explicit_paths': explicit == '1', 'args': args,
               'setup': {'paths': paths, 'modes': modes, 'skills': skills, 'ports': ports, 'forwards': forwards,
                         'ssh': ssh, 'worktree': worktree, 'worktree_locks': locks, 'node_modules': node, 'memory': memory,
                         'image': os.environ.get('CLAUDE_CONTAINED_IMAGE', 'claude-contained:latest'),
                         'gh_token_hash': hashlib.sha256(os.environ.get('AI_GH_TOKEN', '').encode()).hexdigest()}}
    if tool not in ('claude', 'codex', 'copilot', 'gemini', 'vibe'):
        fail('Unknown tool: ' + tool)
    os.umask(0o077)
    return supervise(request, launcher, original)


if __name__ == '__main__':
    try:
        sys.exit(main(sys.argv[1:]))
    except (RuntimeError, ValueError, OSError, subprocess.TimeoutExpired) as exc:
        print('error: ' + str(exc), file=sys.stderr)
        sys.exit(1)
# END EMBEDDED MANAGED LAUNCH
CC_MANAGED_PY
)" "container" "$0" "$tool" "$shell_mode" "$yolo_mode" "$attach_mode" "$attach_name" \
    "$ssh_mode" "$worktree_mode" "$lock_worktrees" "$contained_node_modules" "${CLAUDE_MEMORY:-8g}" "$explicit_paths" \
    "${#paths[@]}" "${paths[@]}" "${#path_modes[@]}" "${path_modes[@]}" \
    "${#share_skills_dirs[@]}" "${share_skills_dirs[@]+"${share_skills_dirs[@]}"}" \
    "${#port_maps[@]}" "${port_maps[@]+"${port_maps[@]}"}" \
    "${#host_forwards[@]}" "${host_forwards[@]+"${host_forwards[@]}"}" \
    "${#tool_args[@]}" "${tool_args[@]+"${tool_args[@]}"}" \
    "${#CC_ORIGINAL_ARGS[@]}" "${CC_ORIGINAL_ARGS[@]+"${CC_ORIGINAL_ARGS[@]}"}"
}

# Test hook: when sourced with CLAUDE_CONTAINED_LIB_ONLY=1, stop here so the
# helper functions above can be unit-tested without launching a container.
if [[ -n "${CLAUDE_CONTAINED_LIB_ONLY:-}" ]]; then
  return 0
fi

if [[ -z "${CC_TOKEN:-}" ]]; then
  managed_launch
  exit $?
fi
main_host="$CC_MAIN_FOLDER"
paths=()
while IFS= read -r p; do paths+=("$p"); done <<< "$CC_PATHS"
share_skills_dirs=()
if [[ -n "$CC_SKILLS" ]]; then
  while IFS= read -r p; do share_skills_dirs+=("$p"); done <<< "$CC_SKILLS"
fi

mounted_roots=("$main_host")
for p in "${paths[@]:1}"; do
  mounted_roots+=("$(resolve_path "$p")")
done

# Check if main directory is a git worktree
worktree_main_repo=""
worktree_main_repo="$(get_worktree_main_repo "$main_host")" || true

if [[ -n "$worktree_main_repo" ]]; then
  if [[ $worktree_mode -eq 1 ]]; then
    # Auto-include mode: just inform the user
    echo "Worktree detected: mounting ${worktree_main_repo}/.git for full git access"
  else
    # Prompt mode: ask the user
    echo "Working directory is a git worktree linked to: ${worktree_main_repo}"
    read -p "Mount main repository's .git for full git access? [Y/n] " answer
    case "${answer:-Y}" in
      [Yy]* ) : ;;  # Continue, will be included
      * ) worktree_main_repo="" ;;  # Don't include
    esac
  fi
fi
if [[ -n "$worktree_main_repo" ]]; then
  mounted_roots+=("${worktree_main_repo}/.git")
fi

# Capture host HOME for path parity
HOST_HOME="$HOME"
HOST_CLAUDE_DIR="${HOST_HOME}/.claude"
HOST_CODEX_DIR="$CC_CODEX_HOME"
HOST_GEMINI_DIR="${HOST_HOME}/.gemini"
HOST_COPILOT_DIR="${HOST_HOME}/.copilot"
HOST_VIBE_DIR="${HOST_HOME}/.vibe"
HOST_M2_DIR="${HOST_HOME}/.m2"
HOST_VAADIN_DIR="${HOST_HOME}/.vaadin"
# Rust state is arch-tagged and container-only: ~/.cargo/bin and ~/.rustup/toolchains
# hold platform-specific binaries, and rustup rewrites the proxies in ~/.cargo/bin
# whenever it installs a toolchain -- pointing those at the host dirs would break a
# host Rust install (and shadow the container's toolchain on PATH).
HOST_RUST_PLATFORM="linux-$(container_arch)"
HOST_CARGO_DIR="${HOST_HOME}/.claude-contained/cargo-${HOST_RUST_PLATFORM}"
HOST_RUSTUP_DIR="${HOST_HOME}/.claude-contained/rustup-${HOST_RUST_PLATFORM}"
HOST_GITCONFIG="${HOST_HOME}/.gitconfig"

# Ensure persistent directories exist on host
mkdir -p "${HOST_CLAUDE_DIR}" "${HOST_CODEX_DIR}" "${HOST_COPILOT_DIR}" "${HOST_GEMINI_DIR}" "${HOST_VIBE_DIR}" "${HOST_M2_DIR}" "${HOST_VAADIN_DIR}" "${HOST_CARGO_DIR}" "${HOST_RUSTUP_DIR}"

# Build container args
CLAUDE_MEMORY="${CLAUDE_MEMORY:-8g}"
container_name="$CC_CONTAINER_NAME"
worktree_lock_repo="$worktree_main_repo"
if [[ -z "$worktree_lock_repo" ]]; then
  worktree_lock_repo="$(get_main_worktree_repo_root "$main_host")" || true
fi
trap cleanup_auto_worktree_locks EXIT
# Route common termination signals through `exit` so the EXIT handler (which
# releases the mutex and removes this container's lock owners) always runs.
# Bash defers a trapped signal until the foreground `container run` returns, so
# cleanup never fires while the container could still prune worktrees.
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP
maybe_offer_worktree_locks "$worktree_lock_repo" "$container_name"
HOST_TZ="$(host_timezone)"
container_argv=(
  container run --rm -it
  --entrypoint /usr/local/bin/managed-entrypoint.sh
  --memory "${CLAUDE_MEMORY}"
  --name "$container_name"
  --label "io.claude-contained.owner=$CC_TOKEN"
  -e "CC_TOKEN=$CC_TOKEN"
  -e "CC_RUNTIME=$CC_RUNTIME"
  -e "HOST_HOME=${HOST_HOME}"
  -e "HOST_UID=$(id -u)"
  -e "HOST_GID=$(id -g)"
  -w "${main_host}"
  ${HOST_TZ:+-e "TZ=${HOST_TZ}"}
  ${AI_GH_TOKEN:+-e "GH_TOKEN=${AI_GH_TOKEN}"}
  --mount "type=bind,src=${HOST_CLAUDE_DIR},dst=${HOST_HOME}/.claude"
  --mount "type=bind,src=${HOST_CODEX_DIR},dst=${HOST_HOME}/.codex"
  --mount "type=bind,src=${HOST_COPILOT_DIR},dst=${HOST_HOME}/.copilot"
  --mount "type=bind,src=${HOST_GEMINI_DIR},dst=${HOST_HOME}/.gemini"
  --mount "type=bind,src=${HOST_VIBE_DIR},dst=${HOST_HOME}/.vibe"
  --mount "type=bind,src=${HOST_M2_DIR},dst=${HOST_HOME}/.m2"
  --mount "type=bind,src=${HOST_VAADIN_DIR},dst=${HOST_HOME}/.vaadin"
  --mount "type=bind,src=${HOST_CARGO_DIR},dst=${HOST_HOME}/.cargo"
  --mount "type=bind,src=${HOST_RUSTUP_DIR},dst=${HOST_HOME}/.rustup"
  --mount "type=bind,src=${main_host},dst=${main_host}"
)

prepare_shared_skills

if [[ -n "$share_skills_dir" ]]; then
  add_shared_skills_mount "${HOST_CLAUDE_DIR}/skills" "${HOST_CLAUDE_DIR}"
  add_shared_skills_mount "${HOST_HOME}/.codex/skills" ""
  add_shared_skills_mount "${HOST_HOME}/.agents/skills" "${HOST_HOME}/.agents"
  add_shared_skills_mount "${HOST_COPILOT_DIR}/skills" "${HOST_COPILOT_DIR}"
  add_shared_skills_mount "${HOST_GEMINI_DIR}/skills" "${HOST_GEMINI_DIR}"
  add_shared_skills_mount "${HOST_VIBE_DIR}/skills" "${HOST_VIBE_DIR}"
  show_shared_skills_summary

  if [[ -d "${HOST_CODEX_DIR}/skills/.system" ]]; then
    container_argv+=( --mount "type=bind,src=${HOST_CODEX_DIR}/skills/.system,dst=${HOST_HOME}/.codex/skills/.system" )
  fi
fi

# Mount worktree's main repository .git directory (not the working tree)
if [[ -n "$worktree_main_repo" ]]; then
  container_argv+=( --mount "type=bind,src=${worktree_main_repo}/.git,dst=${worktree_main_repo}/.git" )
fi

# Protect .git/config from AI tools changing remote URLs
git_protect_dirs="${main_host}"
for p in "${paths[@]:1}"; do
  git_protect_dirs="${git_protect_dirs}:$(resolve_path "$p")"
done
if [[ -n "$worktree_main_repo" ]]; then
  git_protect_dirs="${git_protect_dirs}:${worktree_main_repo}"
fi
container_argv+=( -e "GIT_PROTECT_DIRS=${git_protect_dirs}" )

# Add port mappings
for pm in "${port_maps[@]+"${port_maps[@]}"}"; do
  container_argv+=( -p "$pm" )
done

# Add host port forwards (container localhost → host)
if [[ ${#host_forwards[@]} -gt 0 ]]; then
  IFS=','; forwards_str="${host_forwards[*]}"; unset IFS
  container_argv+=( -e "HOST_FORWARD_PORTS=${forwards_str}" )
fi

# SSH agent forwarding (opt-in for security)
if [[ $ssh_mode -eq 1 ]]; then
  container_argv+=( --ssh )
fi

# The supervisor migrates Claude's shared config under a host mutex. Mount
# only this directory; mounting its parent would expose every Codex store/lock.
container_argv+=( --mount "type=bind,src=${CC_SHARED_DIR},dst=${HOST_HOME}/.claude-contained" )

# Build tool-specific command
case "$tool" in
  claude)
    tool_argv=(claude)
    [[ $yolo_mode -eq 1 ]] && tool_argv+=(--dangerously-skip-permissions)
    ;;
  codex)
    tool_argv=(codex)
    [[ $yolo_mode -eq 1 ]] && tool_argv+=(--yolo)
    ;;
  copilot)
    tool_argv=(copilot)
    [[ $yolo_mode -eq 1 ]] && tool_argv+=(--yolo)
    ;;
  gemini)
    tool_argv=(gemini)
    [[ $yolo_mode -eq 1 ]] && tool_argv+=(--yolo)
    ;;
  vibe)
    tool_argv=(vibe)
    [[ $yolo_mode -eq 1 ]] && echo "Warning: vibe does not support yolo mode (no equivalent flag)" >&2
    ;;
  *)
    echo "Unknown tool: $tool" >&2
    echo "Supported tools: claude, codex, copilot, gemini, vibe" >&2
    exit 1
    ;;
esac

# Additional mounts at original host paths
for i in "${!paths[@]}"; do
  [[ $i -eq 0 ]] && continue
  hp="$(resolve_path "${paths[$i]}")"
  mopts="type=bind,src=${hp},dst=${hp}"
  [[ "${path_modes[$i]}" == "ro" ]] && mopts="${mopts},readonly"
  container_argv+=( --mount "$mopts" )
  # Only claude and codex support --add-dir
  [[ "$tool" == "claude" || "$tool" == "codex" ]] && tool_argv+=( --add-dir "${hp}" )
done

# Platform-specific node_modules overlay
if [[ "$(uname)" != "Linux" ]]; then
  # Container is Linux; host is not — node_modules may need platform-specific binaries
  nm_platform="linux-$(container_arch)"
  nm_check_dirs=("$main_host")
  # Skip read-only extras: the overlay needs to write .claude-contained/ inside the dir.
  for i in "${!paths[@]}"; do
    [[ $i -eq 0 ]] && continue
    [[ "${path_modes[$i]}" == "ro" ]] && continue
    nm_check_dirs+=("$(resolve_path "${paths[$i]}")")
  done

  nm_overlay_dirs=()
  for nm_dir in "${nm_check_dirs[@]}"; do
    [[ -f "${nm_dir}/package.json" ]] && nm_overlay_dirs+=("$nm_dir")
  done

  if [[ ${#nm_overlay_dirs[@]} -gt 0 ]]; then
    do_overlay=$contained_node_modules
    if [[ $do_overlay -eq 0 ]]; then
      read -p "Node.js project detected. Use container-specific node_modules? [Y/n] " answer
      [[ "${answer:-Y}" =~ ^[Yy] ]] && do_overlay=1
    fi

    if [[ $do_overlay -eq 1 ]]; then
      for nm_dir in "${nm_overlay_dirs[@]}"; do
        nm_target="${nm_dir}/.claude-contained/node_modules-${nm_platform}"
        mkdir -p "${nm_target}"
        container_argv+=( --mount "type=bind,src=${nm_target},dst=${nm_dir}/node_modules" )
        if dir_is_empty "${nm_target}"; then
          echo "Created ${nm_target}" >&2
          echo "  Run 'npm install' (or your package manager) inside the container." >&2
        fi
      done
    fi
  fi
fi

# Note: worktree main repo is NOT added via --add-dir since only .git is mounted (no working tree)

# Append user's tool args
if [[ ${#tool_args[@]} -gt 0 ]]; then
  tool_argv+=( "${tool_args[@]}" )
fi

# Run container
if [[ $shell_mode -eq 1 ]]; then
  "${container_argv[@]}" "${CLAUDE_CONTAINED_IMAGE:-claude-contained:latest}" bash && container_exit=0 || container_exit=$?
else
  "${container_argv[@]}" "${CLAUDE_CONTAINED_IMAGE:-claude-contained:latest}" "${tool_argv[@]}" && container_exit=0 || container_exit=$?
fi

check_for_updates

exit "$container_exit"
